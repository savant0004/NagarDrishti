PORT=5000
NODE_ENV=development
# Set true only for seeded, in-memory Bengaluru sample data. Set false for MongoDB-backed records.
DEMO_MODE=true
MONGODB_URI=mongodb://127.0.0.1:27017/nagardrishti
# Generate a random secret with at least 32 bytes; keep it private.
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
CLIENT_URL=http://localhost:5173
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
# Optional admin credentials for demo mode; use a password of at least 12 characters.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_a_long_demo_password
# Optional only for live mode: provisioning the first MongoDB administrator.
# ADMIN_EMAIL=admin@example.test
# ADMIN_PASSWORD=replace_with_a_long_admin_password
# ADMIN_NAME=NagarDrishti Administrator
