# NagarDrishti Backend Environment

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/nagardrishti
MONGODB_DATABASE=nagardrishti
MONGO_DEMO_URI=
MONGO_DATABASE_MODE=live

# Application
DEMO_MODE=true

# Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# Groq AI
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Demo Administrator
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_a_long_demo_password

# Production Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_secure_password
# ADMIN_NAME=NagarDrishti Administrator

# Frontend
CLIENT_URL=http://localhost:5173