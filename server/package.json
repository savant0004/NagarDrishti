{
  "name": "nagardrishti-server",
  "version": "1.0.0",
  "description": "NagarDrishti Backend Server",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seedDemo.ts",
    "user:create-admin": "ts-node src/scripts/createAdmin.ts",
    "test": "node --test -r ts-node/register test/*.test.cjs",
    "seed:demo": "ts-node src/scripts/seedMongoDemo.ts",
    "test:assistant:groq": "node --test -r ts-node/register test/assistant.groq.integration.cjs",
    "groq:diagnostic": "node scripts/groq-diagnostic.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "groq-sdk": "^1.6.0",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
