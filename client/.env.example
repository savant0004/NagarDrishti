# NagarDrishti Client — Environment Variables
# Copy this file to .env.local and fill in values

# Backend API origin (required in production; leave empty for local Vite proxy).
VITE_API_URL=
# Optional Socket.IO origin; defaults to VITE_API_URL or the frontend origin.
VITE_SOCKET_URL=
# Browser-visible CARTO key only. Restrict its usage to deployed site origins.
VITE_CARTO_API_KEY=
