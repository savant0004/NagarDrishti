# NagarDrishti Client — Environment Variables
# Copy this file to .env.local and fill in values

# Backend API URL (leave EMPTY for local dev — Vite proxy handles it automatically)
# Set this ONLY when deploying to Vercel/Netlify/etc. pointing to your backend
# Example: VITE_API_URL=https://nagardrishti-api.railway.app
VITE_API_URL=
