# NagarDrishti Environment Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/nagardrishti

# Explicitly use seeded in-memory Bengaluru sample records only when true.
# When false, the API reports unavailable until MongoDB connects.
DEMO_MODE=true

# Required server-side session signing secret (at least 32 random bytes).
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# Optional demo administrator credentials (at least 12 characters).
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_a_long_demo_password

# Client Application URL
CLIENT_URL=http://localhost:5173
