# ==========================================

# NagarDrishti - Server Environment

# ==========================================

# Server Configuration

PORT=5000
NODE_ENV=development

# ==========================================

# MongoDB Configuration

# ==========================================

# Local MongoDB or MongoDB Atlas connection string

MONGODB_URI=mongodb://127.0.0.1:27017/nagardrishti

# Database name (optional if already included in URI)

MONGODB_DATABASE=nagardrishti

# Optional separate URI for demo database

MONGO_DEMO_URI=
MONGO_DATABASE_MODE=live

# ==========================================

# Application Mode

# ==========================================

# true  = seeded in-memory Bengaluru sample data

# false = MongoDB-backed live application

DEMO_MODE=true

# ==========================================

# Authentication & Security

# ==========================================

# Generate a secure random secret of at least 32 bytes

JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_bytes

# ==========================================

# Groq AI Configuration

# ==========================================

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ==========================================

# Administrator Configuration

# ==========================================

# Demo administrator credentials

DEMO_ADMIN_EMAIL=[admin@example.test](mailto:admin@example.test)
DEMO_ADMIN_PASSWORD=replace_with_a_long_demo_password

# First live administrator provisioning (optional)

# ADMIN_EMAIL=[admin@example.com](mailto:admin@example.com)

# ADMIN_PASSWORD=replace_with_a_secure_admin_password

# ADMIN_NAME=NagarDrishti Administrator

# ==========================================

# Frontend / CORS Configuration

# ==========================================
